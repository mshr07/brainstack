{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adsage.example/contracts/mcp-tools/v1",
  "title": "AdSage MCP tool request",
  "description": "Phase 7 contract. The server constructs capabilityContext; MCP clients cannot supply it.",
  "unevaluatedProperties": false,
  "oneOf": [
    { "$ref": "#/$defs/searchMetadata" },
    { "$ref": "#/$defs/getSchema" },
    { "$ref": "#/$defs/findJoinPath" },
    { "$ref": "#/$defs/getMetricDefinition" },
    { "$ref": "#/$defs/runSafeSql" },
    { "$ref": "#/$defs/searchDocumentation" },
    { "$ref": "#/$defs/getCampaignSummary" },
    { "$ref": "#/$defs/detectCampaignAnomalies" },
    { "$ref": "#/$defs/submitFeedback" }
  ],
  "$defs": {
    "base": {
      "type": "object",
      "required": ["version", "toolCallId", "deadlineAt"],
      "properties": {
        "version": { "const": "1" },
        "toolCallId": { "type": "string", "format": "uuid" },
        "deadlineAt": { "type": "string", "format": "date-time" }
      }
    },
    "searchMetadata": {
      "allOf": [{ "$ref": "#/$defs/base" }, {
        "type": "object", "required": ["tool", "query", "limit"],
        "properties": { "tool": { "const": "search_metadata" }, "query": { "type": "string", "minLength": 1, "maxLength": 1000 }, "domains": { "type": "array", "maxItems": 20, "items": { "type": "string" } }, "limit": { "type": "integer", "minimum": 1, "maximum": 50 } }
      }]
    },
    "getSchema": {
      "allOf": [{ "$ref": "#/$defs/base" }, {
        "type": "object", "required": ["tool", "datasetId"],
        "properties": { "tool": { "const": "get_schema" }, "datasetId": { "type": "string" }, "versionId": { "type": "string" } }
      }]
    },
    "findJoinPath": {
      "allOf": [{ "$ref": "#/$defs/base" }, {
        "type": "object", "required": ["tool", "fromDatasetId", "toDatasetId"],
        "properties": { "tool": { "const": "find_join_path" }, "fromDatasetId": { "type": "string" }, "toDatasetId": { "type": "string" }, "maxHops": { "type": "integer", "minimum": 1, "maximum": 6, "default": 4 } }
      }]
    },
    "getMetricDefinition": {
      "allOf": [{ "$ref": "#/$defs/base" }, {
        "type": "object", "required": ["tool", "metricName", "asOf"],
        "properties": { "tool": { "const": "get_metric_definition" }, "metricName": { "type": "string" }, "asOf": { "type": "string", "format": "date-time" } }
      }]
    },
    "runSafeSql": {
      "allOf": [{ "$ref": "#/$defs/base" }, {
        "type": "object", "required": ["tool", "queryPlanId", "validatedSqlHash", "maxRows", "maxResultBytes"],
        "properties": { "tool": { "const": "run_safe_sql" }, "queryPlanId": { "type": "string", "format": "uuid" }, "validatedSqlHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "approvalId": { "type": "string", "format": "uuid" }, "maxRows": { "type": "integer", "minimum": 1, "maximum": 10000 }, "maxResultBytes": { "type": "integer", "minimum": 1024, "maximum": 10000000 } }
      }]
    },
    "searchDocumentation": {
      "allOf": [{ "$ref": "#/$defs/base" }, {
        "type": "object", "required": ["tool", "query", "limit"],
        "properties": { "tool": { "const": "search_documentation" }, "query": { "type": "string", "minLength": 1, "maxLength": 1000 }, "sourceKinds": { "type": "array", "items": { "enum": ["glossary", "analyst_doc", "approved_sql", "runbook", "faq", "quality", "lineage", "reviewed_correction"] } }, "limit": { "type": "integer", "minimum": 1, "maximum": 50 } }
      }]
    },
    "getCampaignSummary": {
      "allOf": [{ "$ref": "#/$defs/base" }, {
        "type": "object", "required": ["tool", "campaignIds", "startDate", "endDate"],
        "properties": { "tool": { "const": "get_campaign_summary" }, "campaignIds": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "type": "string", "format": "uuid" } }, "startDate": { "type": "string", "format": "date" }, "endDate": { "type": "string", "format": "date" } }
      }]
    },
    "detectCampaignAnomalies": {
      "allOf": [{ "$ref": "#/$defs/base" }, {
        "type": "object", "required": ["tool", "campaignIds", "metrics", "startDate", "endDate"],
        "properties": { "tool": { "const": "detect_campaign_anomalies" }, "campaignIds": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "type": "string", "format": "uuid" } }, "metrics": { "type": "array", "uniqueItems": true, "items": { "enum": ["CTR", "CPC", "CVR", "ROAS", "spend", "revenue"] } }, "startDate": { "type": "string", "format": "date" }, "endDate": { "type": "string", "format": "date" } }
      }]
    },
    "submitFeedback": {
      "allOf": [{ "$ref": "#/$defs/base" }, {
        "type": "object", "required": ["tool", "runId", "rating"],
        "properties": { "tool": { "const": "submit_feedback" }, "runId": { "type": "string", "format": "uuid" }, "rating": { "enum": ["up", "down"] }, "comment": { "type": "string", "maxLength": 4000 }, "correction": { "type": "string", "maxLength": 8000 } }
      }]
    }
  }
}
